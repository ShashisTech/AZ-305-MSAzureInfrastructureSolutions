sequenceDiagram
    autonumber

    actor User as 👤 User (Any Role)
    participant UI as ⚛️ React+Vite SPA
    participant AC as AuthController
    participant AS as AuthService
    participant LM as LockoutManager
    participant LT as LoginAttemptTracker
    participant PH as PasswordHasher
    participant UAR as UserAccountRepository
    participant AAD as Microsoft Entra ID
    participant KV as Azure Key Vault
    participant AI as App Insights
    participant SWA as Azure Static Web Apps
    participant NC as NavigationService
    participant ULS as UiLayoutService

    rect rgb(20, 40, 70)
        Note over User, ULS: ─────────────────────────────────────────────────────────────────<br/>🔐 PHASE 1 · AUTHENTICATION & LOGIN
        Note over User, ULS: ─────────────────────────────────────────────────────────────────

        User->>UI: Enter Username & Password
        UI->>UI: InputSanitizer.Sanitize(credentials)
        UI->>AC: POST /api/auth/login (LoginRequestDto)
        AC->>AS: Login(LoginRequestDto)

        AS->>UAR: FindByUsername(username)
        UAR-->>AS: UserAccount

        AS->>LM: IsLocked(UserAccount)
        LM->>LT: GetFailedCount(userId)
        LT-->>LM: failedCount
        LM-->>AS: isLocked=true/false

        alt Account is Locked
            AS-->>AC: AccountLockedException
            AC-->>UI: 423 Locked · retry after X mins
            UI-->>User: ❌ Account locked. Try again later.
        else Account is Active
            AS->>PH: Verify(inputPassword, storedHash)
            PH-->>AS: isValid=true/false

            alt Invalid Password
                AS->>LT: Record(userId, failed=true)
                AS->>LM: CheckAndLock(UserAccount)
                LM->>UAR: Save(UserAccount locked)
                AS-->>AC: InvalidCredentialsException
                AC-->>UI: 401 Unauthorised
                UI-->>User: ❌ Invalid credentials
            else Valid Password
                AS->>AAD: ValidateUser & Issue OAuth2 Token
                AAD-->>AS: JWT AccessToken + RefreshToken
                AS->>KV: FetchSigningSecret()
                KV-->>AS: signingSecret
                AS->>LT: Reset(userId)
                AS->>UAR: Save(LastLogin=now)
                AS->>AI: TrackEvent("LoginSuccess", userId)
                AS-->>AC: TokenResult (JWT, RefreshToken)
                AC-->>UI: 200 OK · TokenResult
                UI->>UI: Store JWT in memory (not localStorage)
            end
        end
    end

    rect rgb(20, 55, 40)
        Note over User, ULS: ─────────────────────────────────────────────────────────────────<br/>🗺️ PHASE 2 · ROLE RESOLUTION & NAVIGATION LAYOUT
        Note over User, ULS: ─────────────────────────────────────────────────────────────────

        UI->>SWA: GET /api/layout (JWT in header)
        SWA->>NC: GetAllowedRoutes(userId)
        NC->>AAD: Validate JWT & extract roles/claims
        AAD-->>NC: roles [ "Employee" | "Manager" | "HR" ]
        NC-->>SWA: AllowedRoutes[]
        SWA->>ULS: GetMenuItems(userId)
        ULS->>ULS: LayoutTemplateProvider.GetRoleTemplate(role)
        ULS-->>SWA: MenuItems + LayoutConfig
        SWA-->>UI: 200 · NavigationConfig + MenuItems
        UI-->>User: ✅ Role-specific dashboard rendered
    end

    %% ════════════════════════════════════════════
    %%  EMPLOYEE FLOW
    %% ════════════════════════════════════════════

    actor Emp as 👨‍💼 Employee
    participant ApeeC as AppraiseeController
    participant APS as AppraisalService
    participant APR as AppraisalRepository
    participant ECR as EmployeeCommentsRepository
    participant WST as WorkflowStateTracker
    participant AL as AuditLogger
    participant ATR as AuditTrailRepository
    participant NS as NotificationService

    rect rgb(40, 25, 60)
        Note over Emp, NS: ─────────────────────────────────────────────────────────────────<br/>👨‍💼 PHASE 3 · EMPLOYEE – VIEW & SUBMIT SELF ASSESSMENT
        Note over Emp, NS: ─────────────────────────────────────────────────────────────────

        Emp->>UI: Navigate to My Appraisal
        UI->>ApeeC: GET /api/appraisee/my-appraisal (JWT)
        ApeeC->>APS: GetAppraisalSummary(employeeId)
        APS->>APR: FindByEmployee(employeeId)
        APR-->>APS: Appraisal (Status=PendingSelfAssessment)
        APS-->>ApeeC: AppraisalSummaryDto
        ApeeC-->>UI: 200 · AppraisalSummaryDto
        UI-->>Emp: Appraisal form displayed

        Emp->>UI: Fill Self Assessment & Submit
        UI->>UI: ValidationEngine.Validate(EmployeeCommentsDto)
        UI->>ApeeC: POST /api/appraisee/self-assessment (EmployeeCommentsDto)
        ApeeC->>APS: SubmitAppraisal(appraisalId)
        APS->>WST: IsTransitionAllowed("PendingSelf","Submitted")
        WST-->>APS: allowed=true
        APS->>ECR: Save(EmployeeComments)
        APS->>APR: Save(Appraisal · Status=Submitted)
        APS->>AL: Log("SubmitSelfAssessment", appraisalId, employeeId)
        AL->>ATR: Save(AuditTrail)
        APS->>NS: SendStatusChange(managerId,"AppraisalSubmitted")
        NS-->>Emp: 📧 Confirmation email sent
        APS-->>ApeeC: Success
        ApeeC-->>UI: 200 · OK
        UI-->>Emp: ✅ Self assessment submitted

        Emp->>UI: View Upcoming Appraisals
        UI->>ApeeC: GET /api/appraisee/upcoming
        ApeeC->>APS: GetUpcomingAppraisals(employeeId)
        APS->>APR: FindByCycle(activeCycleId)
        APR-->>APS: List~Appraisal~
        APS-->>ApeeC: List~UpcomingAppraisalDto~
        ApeeC-->>UI: 200 · List~UpcomingAppraisalDto~
        UI-->>Emp: Upcoming appraisals list shown
    end

    %% ════════════════════════════════════════════
    %%  MANAGER FLOW
    %% ════════════════════════════════════════════

    actor Mgr as 🧑‍💼 Manager
    participant AprC as AppraiserController
    participant AAS as AppraisalAssignmentService
    participant ASR as AssignmentRepository
    participant MCR as ManagerCommentsRepository
    participant CTCR as CtcRepository
    participant PDR as PromotionDecisionRepository

    rect rgb(50, 35, 15)
        Note over Mgr, PDR: ─────────────────────────────────────────────────────────────────<br/>🧑‍💼 PHASE 4 · MANAGER – REVIEW, COMMENT & DECIDE
        Note over Mgr, PDR: ─────────────────────────────────────────────────────────────────

        Mgr->>UI: View Assigned Appraisals
        UI->>AprC: GET /api/appraiser/assigned (JWT)
        AprC->>AAS: GetPendingAssignments(managerId)
        AAS->>ASR: FindByAssignee(managerId)
        ASR-->>AAS: List~Assignment~
        AAS->>APR: FindById(appraisalId) per assignment
        APR-->>AAS: List~Appraisal~
        AAS-->>AprC: List~AppraisalSummaryDto~
        AprC-->>UI: 200 · List~AppraisalSummaryDto~
        UI-->>Mgr: Team appraisals dashboard

        Mgr->>UI: Open Appraisal · Add Rating & Comments
        UI->>AprC: POST /api/appraiser/manager-comments (ManagerCommentsDto)
        AprC->>APS: SubmitManagerComments(appraisalId, dto)
        APS->>WST: IsTransitionAllowed("Submitted","UnderReview")
        WST-->>APS: allowed=true
        APS->>MCR: Save(ManagerComments)
        APS->>APR: Save(Appraisal · Status=UnderReview)
        APS->>AL: Log("ManagerComments", appraisalId, managerId)
        AL->>ATR: Save(AuditTrail)
        APS-->>AprC: Success
        AprC-->>UI: 200 · OK
        UI-->>Mgr: ✅ Comments saved

        Mgr->>UI: Submit CTC Revision
        UI->>AprC: POST /api/appraiser/ctc (CtcInfoDto)
        AprC->>APS: SaveCTC(appraisalId, CtcInfoDto)
        APS->>CTCR: Save(CTC · RevisedCTC, HikePercent)
        APS->>AL: Log("CTCRevised", appraisalId, managerId)
        AL->>ATR: Save(AuditTrail)
        APS-->>AprC: Success
        AprC-->>UI: 200 · OK
        UI-->>Mgr: ✅ CTC revision saved

        Mgr->>UI: Submit Promotion Decision
        UI->>AprC: POST /api/appraiser/promotion (PromotionDecisionDto)
        AprC->>APS: SavePromotion(appraisalId, dto)
        APS->>PDR: Save(PromotionDecision)
        APS->>AL: Log("PromotionDecision", appraisalId, managerId)
        AL->>ATR: Save(AuditTrail)
        APS->>NS: SendStatusChange(hrId, "ReadyForHRReview")
        NS-->>Mgr: 📧 HR notified for final review
        AprC-->>UI: 200 · OK
        UI-->>Mgr: ✅ Promotion decision submitted

        Mgr->>UI: Approve Appraisal
        UI->>AprC: PUT /api/appraiser/approve/:appraisalId
        AprC->>APS: ApproveAppraisal(appraisalId)
        APS->>WST: IsTransitionAllowed("UnderReview","ManagerApproved")
        WST-->>APS: allowed=true
        APS->>APR: Save(Appraisal · Status=ManagerApproved)
        APS->>AL: Log("ManagerApproved", appraisalId, managerId)
        AL->>ATR: Save(AuditTrail)
        APS->>NS: SendStatusChange(employeeId,"AppraisalApprovedByManager")
        APS-->>AprC: Success
        AprC-->>UI: 200 · OK
        UI-->>Mgr: ✅ Appraisal approved
    end

    %% ════════════════════════════════════════════
    %%  HR FLOW
    %% ════════════════════════════════════════════

    actor HR as 🧑‍💻 HR Admin
    participant HRC as HRController
    participant EPS as EmployeeProfileService
    participant RS as ReportingService
    participant CP as CachingProvider
    participant SB as Azure Service Bus

    rect rgb(15, 45, 55)
        Note over HR, SB: ─────────────────────────────────────────────────────────────────<br/>🧑‍💻 PHASE 5 · HR – OVERSIGHT, FINALISE & REPORTING
        Note over HR, SB: ─────────────────────────────────────────────────────────────────

        HR->>UI: View All Appraisals Dashboard
        UI->>HRC: GET /api/hr/appraisals (JWT)
        HRC->>RS: GetDepartmentSummary(allDepts)
        RS->>CP: Get("dept-summary-cache")
        CP-->>RS: cache miss
        RS->>APR: FindByCycle(activeCycleId)
        APR-->>RS: List~Appraisal~
        RS->>CP: Set("dept-summary-cache", data, ttl=300s)
        RS-->>HRC: List~AppraisalSummaryDto~
        HRC-->>UI: 200 · List~AppraisalSummaryDto~
        UI-->>HR: Full organisation appraisal dashboard

        HR->>UI: Open Employee Profile & Edit
        UI->>HRC: GET /api/hr/employee/:id
        HRC->>EPS: GetProfile(employeeId)
        EPS-->>HRC: PersonalInfoDto
        HRC-->>UI: 200 · PersonalInfoDto
        HR->>UI: Update profile fields & Save
        UI->>HRC: PUT /api/hr/employee/:id (PersonalInfoDto)
        HRC->>EPS: UpdateProfile(employeeId, dto)
        EPS->>ECR: Save(Employee)
        EPS->>AL: Log("ProfileUpdated", employeeId, hrId)
        AL->>ATR: Save(AuditTrail)
        HRC-->>UI: 200 · OK
        UI-->>HR: ✅ Employee profile updated

        HR->>UI: Finalise & Close Appraisal
        UI->>HRC: PUT /api/hr/appraisal/finalise/:id
        HRC->>APS: ApproveAppraisal(appraisalId)
        APS->>WST: IsTransitionAllowed("ManagerApproved","HRFinalised")
        WST-->>APS: allowed=true
        APS->>APR: Save(Appraisal · Status=HRFinalised)
        APS->>PDR: Confirm(PromotionDecision)
        APS->>CTCR: Confirm(CTC · EffectiveDate)
        APS->>AL: Log("HRFinalised", appraisalId, hrId)
        AL->>ATR: Save(AuditTrail)
        APS->>SB: Publish("AppraisalFinalised" event)
        SB-->>NS: Trigger NotificationService
        NS-->>HR: 📧 Finalisation confirmation
        NS-->>Emp: 📧 Final appraisal result notified
        APS-->>HRC: Success
        HRC-->>UI: 200 · OK
        UI-->>HR: ✅ Appraisal cycle finalised

        HR->>UI: Download CTC & Promotion Report
        UI->>HRC: GET /api/hr/reports/ctc
        HRC->>RS: GetCTCReport(cycleId)
        RS->>CP: Get("ctc-report-cache")
        CP-->>RS: cache hit
        RS-->>HRC: CtcInfoDto[]
        HRC-->>UI: 200 · CtcInfoDto[] + PromotionDecisionDto[]
        UI-->>HR: 📊 Report rendered / downloadable
    end
